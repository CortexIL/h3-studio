{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "oxc",
    "react",
    "typescript",
    "unicorn"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-alert": "error",
    "no-restricted-globals": [
      "error",
      "alert",
      "confirm",
      "prompt"
    ],
    "react/no-danger": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/components/ui"
  ]
}
