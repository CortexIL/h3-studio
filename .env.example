# ─── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://h3:CHANGE_ME@h3-postgres:5432/h3studio
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never regenerate this casually: changing it signs every user out.
SESSION_SECRET=

# ─── Object storage ─────────────────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=h3-studio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ─── First admin ────────────────────────────────────────────────────────────
# Used only when the users table is empty. Change the password from /admin
# afterwards and clear ADMIN_PASSWORD from here.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ─── Optional ───────────────────────────────────────────────────────────────
RUNPOD_API_KEY=            # or save one from /admin after the first deploy
POD_POLICY=off             # off | auto | keep-warm
BUDGET_SESSION_LIMIT_USD=8
KEEP_AUDIO=true            # false strips H3's audio track from every clip
MOCK=false                 # true renders placeholder clips and rents nothing
COOKIE_SECURE=true         # false only for plain-HTTP local development
